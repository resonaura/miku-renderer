{
  "name": "miku-renderer",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "generate:token": "tsx src/scripts/generate.token.ts",
    "dev": "tsx watch src/index.ts",
