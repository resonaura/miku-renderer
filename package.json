{
  "name": "miku-renderer",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --build && npm run copy-schema",
    "copy-schema": "mkdir -p dist/database && cp src/database/schema.sql dist/database/",
    "start": "node dist/index.js",
    "generate:token": "tsx src/scripts/generate.token.ts",
    "dev": "tsx watch src/index.ts",
    "render": "tsx src/cli.ts input.example.json output.mp4",
    "dev:render": "tsx watch src/cli.ts input.example.json output.mp4"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "better-sqlite3": "^12.11.1",
    "cli-highlight": "^2.1.11",
    "dotenv": "^17.2.1",
    "fastify": "^5.12.8",
    "ffprobe": "^1.1.2",
    "p-queue": "^8.1.0",
    "sql-ddl-to-json-schema": "^6.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ffprobe": "^1.1.8",
    "@types/node": "^24.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "axios@^1": "^1.21.1",
    "form-data@^4": "^4.0.6",
    "form-data@^2": "^2.5.6",
    "follow-redirects": ">=1.16.2",
    "brace-expansion@^1": "^1.1.22",
    "brace-expansion@^2": "^2.1.8",
    "brace-expansion@^5": "^5.0.13",
    "js-yaml@^4": "^4.3.2",
    "js-yaml@^3": "^3.15.2",
    "lodash@^4": "^4.17.24",
    "lodash-es@^4": "^4.17.24",
    "handlebars@^4": "^4.7.10",
    "ws@^8": "^8.21.0",
    "ws@^7": "^7.5.14",
    "tar@^7": "^7.5.23",
    "tar@^6": "^7.5.23",
    "picomatch@^2": "^2.3.2",
    "picomatch@^4": "^4.0.4",
    "flatted": ">=3.4.2",
    "serialize-javascript": ">=7.1.4",
